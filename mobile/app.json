{
  "expo": {
    "name": "NotreRue.fr",
    "slug": "notrerue",
    "scheme": "notrerue",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.notrerue.app"
    },
    "android": {
      "package": "fr.notrerue.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "NotreRue.fr a besoin d'accéder à vos photos pour joindre une image à une demande.",
          "cameraPermission": "NotreRue.fr a besoin d'accéder à l'appareil photo pour joindre une photo à une demande."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
