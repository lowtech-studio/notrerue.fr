{
  "expo": {
    "name": "NotreRue.fr",
    "slug": "notreruefr",
    "scheme": "notrerue",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.notrerue.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.notrerue.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-updates",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "NotreRue.fr a besoin d'accéder à vos photos pour joindre une image à une demande.",
          "cameraPermission": "NotreRue.fr a besoin d'accéder à l'appareil photo pour joindre une photo à une demande."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43086d55-8a4a-4bf9-a8ac-86f05defe37a"
      }
    },
    "owner": "lowtech-studio",
    "updates": {
      "url": "https://u.expo.dev/43086d55-8a4a-4bf9-a8ac-86f05defe37a"
    }
  }
}
