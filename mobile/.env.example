# Copier en `.env` (jamais commité, voir .gitignore) — lu par Expo au build
# (préfixe `EXPO_PUBLIC_` obligatoire pour qu'une variable soit exposée au
# bundle JS, cf. lib/api.ts et la doc Expo sur les variables d'env).

# Origine de l'API NotreRue.fr (web/routes/api/v1/*). En dev, l'IP locale de
# la machine qui fait tourner `deno task dev` (pas `localhost` : un appareil
# physique ou le simulateur/émulateur ne résout pas le `localhost` de la
# machine hôte) — ex. http://192.168.1.42:8000. En prod, https://notrerue.fr.
EXPO_PUBLIC_API_URL=http://localhost:8000
