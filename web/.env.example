# Copier en `.env` (jamais commité, voir .gitignore) et compléter — lu via
# Deno.env côté serveur uniquement (cf. AGENTS.md « Cyber sécurité »).

# Connexion Postgres (cf. compose.yaml pour la stack de dev).
DATABASE_URL=postgres://postgres:example@localhost:5432/notre_rue

# Secret de signature des cookies de session — obligatoire, valeur aléatoire
# et unique en production (jamais la valeur de dev utilisée par compose.yaml).
SESSION_SECRET=

# Nombre max de connexions Postgres simultanées du pool applicatif (cf.
# db/client.ts) — facultatif, 5 par défaut. Volontairement bas : cible de
# déploiement un Raspberry Pi, où chaque connexion inactive coûte de la RAM.
DATABASE_POOL_MAX=5

# Provider d'e-mail (codes de connexion, invitations, notifications) — cf.
# email/brevo.ts. Créer une clé API sur https://app.brevo.com.
BREVO_API_KEY=
# Adresse d'expédition, doit être vérifiée côté Brevo.
EMAIL_FROM=
